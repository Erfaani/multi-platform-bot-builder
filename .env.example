# =============================================================================
# Bot Builder Platform — environment template
# Copy to .env and replace every CHANGE_ME. NEVER commit .env.
# =============================================================================

# --- Django core -------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENVIRONMENT=local

# --- URLs --------------------------------------------------------------------
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
# Public HTTPS base used to register platform webhooks (tunnel URL in development)
PUBLIC_WEBHOOK_BASE_URL=https://CHANGE_ME.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://botbuilder:CHANGE_ME@postgres:5432/botbuilder
POSTGRES_DB=botbuilder
POSTGRES_USER=botbuilder
POSTGRES_PASSWORD=CHANGE_ME
DB_CONN_MAX_AGE=60
# Host ports the containers publish on. Change these if you already run
# PostgreSQL or Redis locally — a native service on 5432 shadows the container
# and shows up as a confusing "password authentication failed".
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_URL=redis://redis:6379/3

# --- Encryption --------------------------------------------------------------
# Key-encryption key for bot credentials (envelope encryption).
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Wraps every bot credential. Generate a real one before anything works — the value
# below is an invalid placeholder on purpose, and `manage.py check` will refuse it
# (core.E002) rather than letting you discover the problem when a customer connects
# their bot. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEK=CHANGE_ME_base64_32_bytes
ENCRYPTION_KEK_VERSION=1
# Comma-separated previous keys, kept only for rotation: "2:<key>,1:<key>"
ENCRYPTION_KEK_PREVIOUS=

# --- Auth --------------------------------------------------------------------
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=14
JWT_ROTATE_REFRESH_TOKENS=true

# --- Localization ------------------------------------------------------------
DEFAULT_LOCALE=en
ACTIVE_LOCALES=en,fa
DEFAULT_CURRENCY=USD
ACTIVE_CURRENCIES=USD,EUR,IRR,USDT
DEFAULT_TIMEZONE=UTC

# --- Bot runtime -------------------------------------------------------------
# webhook (production) | polling (local development without a tunnel)
BOT_RUNTIME_MODE=webhook
BOT_OUTBOUND_RATE_PER_BOT=25          # messages/sec, stay under the platform limit
BOT_OUTBOUND_RATE_PER_CHAT=1          # messages/sec
BOT_SESSION_TTL_MINUTES=30
INBOUND_UPDATE_RETENTION_DAYS=30

# --- Telegram ----------------------------------------------------------------
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_PROXY_URL=
TELEGRAM_REQUEST_TIMEOUT=15
# Platform-owned builder bot (see TELEGRAM.md §8)
TELEGRAM_BUILDER_BOT_TOKEN=
TELEGRAM_BUILDER_BOT_USERNAME=

# --- Bale --------------------------------------------------------------------
BALE_API_BASE_URL=https://tapi.bale.ai
BALE_PROXY_URL=
BALE_REQUEST_TIMEOUT=15
BALE_BUILDER_BOT_TOKEN=
BALE_BUILDER_BOT_USERNAME=

# --- Provisioning ------------------------------------------------------------
# pool | token_handoff  (see TELEGRAM.md §2)
PROVISIONING_DEFAULT_STRATEGY=token_handoff
PROVISIONING_POOL_LOW_WATERMARK=10
# Operations-only BotFather automation. Keep false unless explicitly approved.
PROVISIONING_MTPROTO_ENABLED=false

# --- Storage -----------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
STORAGE_BUCKET_PRIVATE=botbuilder-private
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES_RECEIPT=5242880
UPLOAD_MAX_BYTES_LOGO=2097152
UPLOAD_MAX_BYTES_DOCUMENT=20971520
ANTIVIRUS_SCAN_ENABLED=false

# --- Email -------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- AI ----------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_EMBEDDING_DIMENSIONS=1536
AI_TENANT_MONTHLY_TOKEN_CAP=1000000

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Rate limiting -----------------------------------------------------------
THROTTLE_ANON_PER_MIN=60
THROTTLE_USER_PER_MIN=600
THROTTLE_AUTH_PER_MIN=10
THROTTLE_UPLOAD_PER_HOUR=20

# --- Feature flags -----------------------------------------------------------
FEATURE_BALE_ENABLED=false            # enable after the Phase 5 capability spike
FEATURE_AI_ENABLED=false
MAINTENANCE_MODE=false
